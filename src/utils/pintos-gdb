#! /bin/sh

# Auto Port
export PINTOS_PORT=${PINTOS_PORT:-1234}

# Path to GDB macros file.  Customize for your site.
GDBMACROS=$HOME/.bin/gdb-macros
if ! test -f "$GDBMACROS"; then
	GDBMACROS="$(dirname "$0")/gdb-macros"
fi

# Choose correct GDB.
# Prefer plain gdb: cgdb 0.8 segfaults with gdb >= 13 when attaching
# to a remote target.  gdb itself handles i386 ELF natively.
GDB=gdb
command -v i386-elf-gdb >/dev/null 2>&1 && GDB=i386-elf-gdb

# Run GDB.
if test -f "$GDBMACROS"; then
	exec $GDB -ex "target remote localhost:$PINTOS_PORT" -x "$GDBMACROS" "$@"
else
	echo "*** $GDBMACROS does not exist ***"
	echo "*** Pintos GDB macros will not be available ***"
	exec $GDB -ex "target remote localhost:$PINTOS_PORT" "$@"
fi
